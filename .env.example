# Copy this file to .env and use different values for each environment.
# Do not commit .env or production credentials.

POSTGRES_DB=freight_events
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/freight_events

# This database is used exclusively by tests marked as integration.
POSTGRES_TEST_DB=freight_events_test
POSTGRES_TEST_USER=postgres
POSTGRES_TEST_PASSWORD=change-me-test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me-test@localhost:5433/freight_events_test

# RabbitMQ is used by the Phase 4 worker. Keep these values environment-specific.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_EXCHANGE=freight.shipment-events
RABBITMQ_QUEUE=freight.shipment-event-ingestion
RABBITMQ_RETRY_EXCHANGE=freight.shipment-events.retry
RABBITMQ_RETRY_QUEUE=freight.shipment-event-retry
RABBITMQ_DEAD_LETTER_EXCHANGE=freight.shipment-events.dlx
RABBITMQ_DEAD_LETTER_QUEUE=freight.shipment-event-dlq
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_ATTEMPTS=3
